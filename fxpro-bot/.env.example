# Copy to `.env` and fill in your FXPro *DEMO* account details.
# The real `.env` is gitignored — never commit credentials.
#
# Find these in MetaTrader 5: the login number is shown after you open a demo
# account; the server name is e.g. "FxPro-MT5" or "FxPro-Demo" (see MT5 login dialog).
MT5_LOGIN=12345678
MT5_PASSWORD=your-demo-password
MT5_SERVER=FxPro-MT5

# Optional: full path to terminal64.exe if MT5 isn't auto-detected.
# MT5_TERMINAL_PATH=C:\Program Files\FxPro - MetaTrader 5\terminal64.exe

# Optional: only needed if news.sentiment_engine = claude (the news layer).
# Get a key at https://console.anthropic.com. Costs a little per call.
# ANTHROPIC_API_KEY=sk-ant-...
